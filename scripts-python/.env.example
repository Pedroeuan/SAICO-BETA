# ------------------------------------------------------------
# Entorno del orquestador Python
# development, staging o production según tu despliegue
# ------------------------------------------------------------
PYTHON_ENV=development

# ------------------------------------------------------------
# Base de datos MySQL usada por Laravel
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saico_beta
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------
# LinkedIn
# ACCESS TOKEN con permisos para publicaciones UGC
# PERSON URN ejemplo: urn:li:person:xxxxxxxx
# ORG ID solo si publicarás como organización
# ------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_ORG_ID=

# ------------------------------------------------------------
# Facebook
# PAGE ID de la página de empresa
# PAGE ACCESS TOKEN con permisos pages_manage_posts
# ------------------------------------------------------------
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ------------------------------------------------------------
# X / Twitter
# Credenciales de app y access token del usuario autorizado
# ------------------------------------------------------------
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
